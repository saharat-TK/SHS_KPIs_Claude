# MySQL database connection — copy this file to .env.local and fill in real values.
# .env.local is already gitignored; never commit actual credentials.

DB_PORT=3306
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=shs_kpis_claude

# Combined connection string (mysql2 / Prisma style), kept in sync with the
# individual vars above.
DATABASE_URL=mysql://root:@localhost:3306/shs_kpis_claude

# ── Auth.js v5 / Google OAuth ────────────────────────────────────────────────
# Generate with `npx auth secret` (or `openssl rand -base64 32`). Signs the
# session JWT — changing it invalidates everyone's session.
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Auth.js infers the Google provider's credentials from
# these exact variable names.
#
# The authorized redirect URI registered there must be, exactly:
#   http://localhost:3000/api/auth/callback/google
# (and https://<prod-host>/api/auth/callback/google for production).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Canonical origin — no trailing slash, no /api/auth suffix (that was v4's
# NEXTAUTH_URL convention). AUTH_TRUST_HOST is required on any non-Vercel host,
# including a local `next start`.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google Workspace domain sign-in is pinned to. Used both as the `hd` hint on
# the authorization URL and as a server-side check in the signIn callback.
AUTH_ALLOWED_DOMAIN=mfu.ac.th
