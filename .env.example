# MySQL database connection — copy this file to .env.local and fill in real values.
# .env.local is already gitignored; never commit actual credentials.

DB_PORT=3306
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=shs_kpis_claude

# Combined connection string (mysql2 / Prisma style), kept in sync with the
# individual vars above.
DATABASE_URL=mysql://root:@localhost:3306/shs_kpis_claude
